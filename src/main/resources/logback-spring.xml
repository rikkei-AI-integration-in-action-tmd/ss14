<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true" scanPeriod="30 seconds">
    <appender name="STDERR_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %5p [traceId=%X{traceId} spanId=%X{spanId}] [%15.15t] %-40.40logger{39} : %m%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <logger name="org.springframework.boot" level="INFO" />
    <logger name="org.springframework.ai" level="INFO" />
    <logger name="org.hibernate" level="WARN" />
    <logger name="com.rikkei.smarthub" level="DEBUG" />
    <logger name="io.opentelemetry" level="WARN" />

    <root level="INFO">
        <appender-ref ref="STDERR_CONSOLE" />
    </root>
</configuration>
